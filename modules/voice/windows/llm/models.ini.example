version = 1

; llama-server's model presets (router mode: --models-preset models.ini). Copy to
; D:\local-ai\llama.cpp\models.ini. Each [section] is a model you can ask for by name;
; only one is loaded at a time (--models-max 1), on first use.

; Global settings. --fit (on by default) sizes the GPU/CPU split to the card's free VRAM.
[*]
c = 32768
flash-attn = on
jinja = true

; The voice assistant's model: fits a 12 GB card next to Whisper and F5-TTS. Download the
; GGUF and its mmproj (vision) file from Hugging Face; these are the tested file names.
[gemma-4-12b]
model = C:\local-ai\models\llm\gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
mmproj = C:\local-ai\models\llm\gemma-4-12B-it-mmproj-F16.gguf
temp = 1.0
top-p = 0.95
top-k = 64
