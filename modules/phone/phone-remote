def portal_url():
    if TAILNET_HOST and tls_context():
        return f"https://{TAILNET_HOST}:{TLS_PORT}/?portal=1"
    return f"http://{AP_ADDRESS}:{PORT}/?portal=1"


_tls = {"mtime": None, "context": None}


def tls_context():
    """The HTTPS context with the current certificate, reloaded when it's renewed; None without one."""
    try:
        mtime = max(os.stat(TLS_CERT).st_mtime, os.stat(TLS_KEY).st_mtime)
        if mtime != _tls["mtime"]:
            context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
            context.load_cert_chain(TLS_CERT, TLS_KEY)
            _tls.update(mtime=mtime, context=context)
    except (OSError, ssl.SSLError):
        return None
    return _tls["context"]


def api(url, payload=None, data=None, kind=None, timeout=120):
    """POST to an assistant endpoint (JSON PAYLOAD, or DATA of type KIND); the reply's bytes."""
    if payload is not None:
        data, kind = json.dumps(payload).encode(), "application/json"
    request = urllib.request.Request(url, data, {"Content-Type": kind} if kind else {})
    with urllib.request.urlopen(request, timeout=timeout) as reply:
        return reply.read()


def multipart(fields, filename, kind, audio):
    boundary = uuid.uuid4().hex
    parts = [f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{value}\r\n'.encode()
             for name, value in fields.items()]
    parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{filename}"\r\n'
                 f'Content-Type: {kind}\r\n\r\n'.encode() + audio + b"\r\n")
    parts.append(f"--{boundary}--\r\n".encode())
    return b"".join(parts), f"multipart/form-data; boundary={boundary}"


def assistant_available():
    if not CHAT_URL:
        return False
    try:
        with urllib.request.urlopen(CHAT_URL + "/models", timeout=3) as reply:
            return reply.status == 200
    except (OSError, ValueError):
        return False


def ask_assistant(text, phone):
    session = "celular-" + re.sub(r"[^0-9a-zA-Z.]", "", phone)  # one conversation per phone
    body = {"model": "pipa", "user": session, "messages": [{"role": "user", "content": text}]}
    reply = json.loads(api(CHAT_URL + "/chat/completions", body, timeout=300))
    return (reply["choices"][0]["message"].get("content") or "").strip()


