#!/usr/bin/python3 -I
"""The phone as the TV's remote: a page with the remote's buttons, the home screen's apps, and
the TV's power. Phones on the Pi's own Wi-Fi, the home network or the tailnet open
http://<pi>:8096/.

  GET  /                   the page
  GET  /apps               the home screen's apps: [{"id", "name", "logo"}]
  GET  /logo/<file>        an app's logo, from the menu's media folder
  POST /button/<name>      up, down, left, right, ok, back, home, close or keyboard: the same
                           as the TV remote's button (through cec-remote's socket)
  POST /tv/on, /tv/standby turn the TV on to the Pi's input, or off (kiosk wake / standby)
  POST /app/<id>           open an app on the TV (kiosk run <id>)
  GET  /ws                 WebSocket for the pointer: {"m": [dx, dy]}, {"c": "left"|"right"},
                           {"s": n}, passed on to cec-remote's virtual mouse

The pointer uses the phone's gyroscope, which browsers only allow on HTTPS pages: open it
through `tailscale serve` (https://<pi>.<tailnet>.ts.net:8446/).

It answers only private addresses (the Pi's access point, the home network, the tailnet),
never the internet. Settings, all optional:
  PHONE_REMOTE_PORT        8096
  PHONE_REMOTE_HOME_URL    the "Casa" button's link; default: Home Assistant on the same host,
                           port 8123
"""

import base64
import hashlib
import ipaddress
import json
import os
import re
import socket
import subprocess
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PORT = int(os.environ.get("PHONE_REMOTE_PORT", "8096"))
HOME_URL = os.environ.get("PHONE_REMOTE_HOME_URL", "")
KIOSK = Path.home() / ".local/bin/kiosk"
MENU = Path.home() / ".config/kiosk/menu"
CEC_SOCKET = "/run/cec-remote.sock"
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
BUTTONS = {"up", "down", "left", "right", "ok", "back", "home", "close", "keyboard"}
TAILNET = ipaddress.ip_network("100.64.0.0/10")
# The HTTPS address the page points to for the gyroscope (tailscale serve on port 8446).
TAILNET_HOST = os.environ.get("PHONE_REMOTE_TAILNET_HOST", "")
if not TAILNET_HOST:
    try:
        status = json.loads(subprocess.run(["tailscale", "status", "--json"], capture_output=True,
                                           text=True, timeout=5).stdout or "{}")
        TAILNET_HOST = status.get("Self", {}).get("DNSName", "").rstrip(".")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
# Home screen tiles the phone doesn't offer: a stray tap shouldn't restart the Pi, and the TV's
# power has its own buttons. The streaming services come first.
LEFT_OUT = {"reboot", "standby"}
FIRST = ["netflix", "youtube", "primevideo", "disney", "hbomax", "globoplay", "paramount", "kodi"]


def menu_apps():
    """The apps on the home screen, read from Pegasus's metadata files, in menu order."""
    apps = []
    for meta in sorted(MENU.rglob("metadata*.txt")):
        entry = {}
        for line in meta.read_text(errors="replace").splitlines() + ["game:"]:
            key, _, value = line.partition(":")
            key, value = key.strip(), value.strip()
            if key == "game":
                launch = re.search(r"kiosk run ([\w-]+)", entry.get("launch", ""))
                if launch:
                    logo = entry.get("assets.boxFront", "")
                    apps.append({"id": launch.group(1), "name": entry["game"],
                                 "logo": Path(logo).name if logo else "", "dir": str(meta.parent),
                                 "order": entry.get("sort-by", "")})
                entry = {"game": value}
            elif key and entry:
                entry[key] = value
    seen, unique = set(), []
    for app in apps:
        if app["id"] not in seen and app["id"] not in LEFT_OUT:
            seen.add(app["id"]); unique.append(app)
    first = {app_id: n for n, app_id in enumerate(FIRST)}
    return sorted(unique, key=lambda a: first.get(a["id"], len(first)))


def find_logo(name):
    for path in MENU.rglob(name):
        if path.is_file() and path.suffix.lower() in (".png", ".jpg", ".jpeg", ".svg", ".webp"):
            return path
    return None


def cec(message):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(2)
        sock.connect(CEC_SOCKET)
        sock.sendall((json.dumps(message) + "\n").encode())


