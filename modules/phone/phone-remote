def menu_apps():
    """The apps on the home screen, read from Pegasus's metadata files, in menu order."""
    apps = []
    for meta in sorted(MENU.rglob("metadata*.txt")):
        entry = {}
        for line in meta.read_text(errors="replace").splitlines() + ["game:"]:
            key, _, value = line.partition(":")
            key, value = key.strip(), value.strip()
            if key == "game":
                launch = re.search(r"kiosk run ([\w-]+)", entry.get("launch", ""))
                if launch:
                    logo = entry.get("assets.boxFront", "")
                    apps.append({"id": launch.group(1), "name": entry["game"],
                                 "logo": Path(logo).name if logo else "", "dir": str(meta.parent),
                                 "order": entry.get("sort-by", "")})
                entry = {"game": value}
            elif key and entry:
                entry[key] = value
    seen, unique = set(), []
    for app in apps:
        if app["id"] not in seen and app["id"] not in LEFT_OUT:
            seen.add(app["id"]); unique.append(app)
    first = {app_id: n for n, app_id in enumerate(FIRST)}
    return sorted(unique, key=lambda a: first.get(a["id"], len(first)))


def find_logo(name):
    for path in MENU.rglob(name):
        if path.is_file() and path.suffix.lower() in (".png", ".jpg", ".jpeg", ".svg", ".webp"):
            return path
    return None


def cec(message):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(2)
        sock.connect(CEC_SOCKET)
        sock.sendall((json.dumps(message) + "\n").encode())


def client_mac(ip):
    """The MAC address of a client on the local network, from the kernel's ARP table."""
    try:
        for line in Path("/proc/net/arp").read_text().splitlines()[1:]:
            fields = line.split()
            if len(fields) >= 4 and fields[0] == ip and fields[3] != "00:00:00:00:00:00":
                return fields[3].lower()
    except OSError:
        pass
    return None


def forget_departed():
    """A phone that leaves the Wi-Fi gets the sign-in prompt again when it comes back."""
    iw = shutil.which("iw") or "/usr/sbin/iw"
    while True:
        time.sleep(30)
        try:
            dump = subprocess.run([iw, "dev", AP_INTERFACE, "station", "dump"], capture_output=True,
                                  text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if dump.returncode:
            continue
        here = set(re.findall(r"^Station ([0-9a-f:]{17})", dump.stdout, re.M))
        for key, since in list(signed_in.items()):
            if (":" in key and key not in here) or time.time() - since > 24 * 3600:
                signed_in.pop(key, None)


def wifi_qr_text():
    """The Wi-Fi's name and password in the QR format phone cameras join from; None if unknown."""
    try:
        ssid = subprocess.run(["nmcli", "-g", "802-11-wireless.ssid", "connection", "show", AP_CONNECTION],
                              capture_output=True, text=True, timeout=5).stdout.strip()
        password = AP_PASSWORD.read_text().strip()
    except (OSError, subprocess.TimeoutExpired):
        return None
    if not ssid or not password:
        return None
    escape = lambda s: re.sub(r'([\\;,:"])', r"\\\1", s)
    return f"WIFI:T:WPA;S:{escape(ssid)};P:{escape(password)};;", ssid


def qr_svg(text):
    run = subprocess.run(["qrencode", "-t", "SVG", "-m", "2", "-l", "M", "-o", "-", text],
                         capture_output=True, timeout=10)
    if run.returncode:
        raise OSError(run.stderr.decode(errors="replace").strip() or "qrencode failed")
    svg = run.stdout.decode()
    return svg[svg.index("<svg"):]  # without the XML declaration, to inline it


