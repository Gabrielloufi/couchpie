    const r = await fetch("/assistant/speak", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({text})});
    if (!r.ok) throw new Error();
    voice.src = URL.createObjectURL(await r.blob()); await voice.play();
