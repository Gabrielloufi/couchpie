def read_frame(stream):
    """One WebSocket frame from the client: (opcode, payload), or None when the stream ends."""
    head = stream.read(2)
    if len(head) < 2:
        return None
    opcode, length, masked = head[0] & 0x0F, head[1] & 0x7F, head[1] & 0x80
    if length == 126:
        length = int.from_bytes(stream.read(2), "big")
    elif length == 127:
        length = int.from_bytes(stream.read(8), "big")
    if length > 65536:
        return None
    mask = stream.read(4) if masked else b"\0\0\0\0"
    data = stream.read(length)
    return opcode, bytes(b ^ mask[i % 4] for i, b in enumerate(data))


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def setup(self):
        super().setup()
        if isinstance(self.request, ssl.SSLSocket):  # the handshake here, not in the accepting thread
            self.request.settimeout(15)
            self.request.do_handshake()
            self.request.settimeout(None)

    def allowed(self):
        addr = ipaddress.ip_address(self.client_address[0])
        if addr.version == 6 and addr.ipv4_mapped:
            addr = addr.ipv4_mapped
        return addr.is_private or addr.is_loopback or addr in TAILNET

    def reply(self, status, body, kind="text/plain; charset=utf-8", headers=None):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(status)
        for name, value in (headers or {}).items():
            self.send_header(name, value)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def phone(self):
        """The client's key for the sign-in state: its MAC on the Pi's Wi-Fi, else its address."""
        ip = self.client_address[0].removeprefix("::ffff:")
        return client_mac(ip) or ip

    def probe(self, host):
        """A phone checking for the internet: answered as the internet would once it's done with
        the sign-in page, else sent to the page."""
        if self.phone() in signed_in:
            answer = PROBES[host]
            if answer is None:
                return self.reply(HTTPStatus.NO_CONTENT, b"")
            extra = {"X-NetworkManager-Status": "online"} if host == "nmcheck.gnome.org" else {}
            return self.reply(HTTPStatus.OK, answer, "text/html" if host == "captive.apple.com" else "text/plain", extra)
        url = portal_url()
        self.reply(HTTPStatus.FOUND, f'<a href="{url}">couchPie</a>', "text/html; charset=utf-8", {"Location": url})

    def do_GET(self):
        if not self.allowed():
            return self.reply(HTTPStatus.FORBIDDEN, "only from the local network")
        host = (self.headers.get("Host") or "").split(":")[0].lower()
        if host in PROBES:
            return self.probe(host)
        if self.path == "/ws" and self.headers.get("Upgrade", "").lower() == "websocket":
            return self.pointer_socket()
        path = self.path.split("?")[0]
        https = f"https://{TAILNET_HOST}:{TLS_PORT}/" if TAILNET_HOST else ""
        if host == "couchpie.lan" and path == "/" and https and tls_context():
            return self.reply(HTTPStatus.FOUND, f'<a href="{https}">couchPie</a>', "text/html; charset=utf-8",
                              {"Location": https})
        if path == "/tv":
            return self.tv_page(https)
        if path in ("/", "/index.html"):
            page = (PAGE.replace("__HOME_URL__", HOME_URL).replace("__HTTPS_URL__", https)
                    .replace("__ASSISTANT__", ASSISTANT))
            return self.reply(HTTPStatus.OK, page, "text/html; charset=utf-8")
        if path == "/assistant":
            info = {"name": ASSISTANT, "available": assistant_available()}
            return self.reply(HTTPStatus.OK, json.dumps(info), "application/json")
        if self.path == "/apps":
            apps = [{k: a[k] for k in ("id", "name", "logo")} for a in menu_apps()]
            return self.reply(HTTPStatus.OK, json.dumps(apps, ensure_ascii=False), "application/json")
        if self.path.startswith("/logo/"):
            name = Path(self.path[len("/logo/"):]).name.replace("%20", " ")
            logo = find_logo(name) if name else None
            if logo:
                kind = {"svg": "image/svg+xml", "jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp"}.get(
                    logo.suffix.lower().lstrip("."), "image/png")
                return self.reply(HTTPStatus.OK, logo.read_bytes(), kind)
        self.reply(HTTPStatus.NOT_FOUND, "not found")

    def do_POST(self):
        if not self.allowed():
            return self.reply(HTTPStatus.FORBIDDEN, "only from the local network")
        parts = self.path.split("?")[0].strip("/").split("/")
        if parts[0] == "assistant" and len(parts) == 2:
            return self.assistant(parts[1])
        if parts == ["portal", "done"]:
            signed_in[self.phone()] = time.time()
            return self.reply(HTTPStatus.NO_CONTENT, b"")
        try:
            if len(parts) == 2 and parts[0] == "button" and parts[1] in BUTTONS:
                cec({"button": parts[1]})
            elif len(parts) == 2 and parts[0] == "tv" and parts[1] in ("on", "standby"):
                run = subprocess.run([str(KIOSK), "wake" if parts[1] == "on" else "standby"],
                                     capture_output=True, text=True, timeout=20)
                if run.returncode:
                    return self.reply(HTTPStatus.BAD_GATEWAY, run.stderr.strip()[-200:] or "kiosk failed")
            elif len(parts) == 2 and parts[0] == "app" and parts[1] in {a["id"] for a in menu_apps()}:
                subprocess.Popen([str(KIOSK), "run", parts[1]], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
            else:
                return self.reply(HTTPStatus.NOT_FOUND, "unknown action")
        except OSError as err:
            return self.reply(HTTPStatus.SERVICE_UNAVAILABLE, f"couchPie isn't answering: {err}")
        self.reply(HTTPStatus.NO_CONTENT, b"")

    def tv_page(self, link):
        # The Pi's own browser only: tailscale serve also connects from 127.0.0.1, but it says
        # whom for (X-Forwarded-For)
        if self.client_address[0] not in ("127.0.0.1", "::1") or self.headers.get("X-Forwarded-For"):
            return self.reply(HTTPStatus.FORBIDDEN, "only on the TV")
        wifi = wifi_qr_text()
        if not wifi:
            return self.reply(HTTPStatus.SERVICE_UNAVAILABLE, "the Pi's Wi-Fi isn't set up (modules/ap)")
        link = link or f"http://{AP_ADDRESS}:{PORT}/"
        try:
            page = (TV_PAGE.replace("__WIFI_QR__", qr_svg(wifi[0])).replace("__SSID__", wifi[1])
                    .replace("__LINK_QR__", qr_svg(link)).replace("__LINK__", link.removeprefix("https://").rstrip("/")))
        except (OSError, subprocess.TimeoutExpired) as err:
            return self.reply(HTTPStatus.SERVICE_UNAVAILABLE, f"no QR codes: {err} (apt install qrencode)")
        self.reply(HTTPStatus.OK, page, "text/html; charset=utf-8")

    def assistant(self, action):
        """The voice assistant: what the phone heard or typed, the answer, and its speech."""
        length = int(self.headers.get("Content-Length") or 0)
        if not 0 < length <= MAX_AUDIO:
            return self.reply(HTTPStatus.REQUEST_ENTITY_TOO_LARGE, json.dumps({"error": "empty or too large"}), "application/json")
        body = self.rfile.read(length)
        try:
            if action == "voice":
                kind = (self.headers.get("Content-Type") or "audio/webm").split(";")[0]
                form, form_type = multipart({"language": "pt", "response_format": "json"},
                                            "phone." + kind.split("/")[-1], kind, body)
                heard = json.loads(api(STT_URL + "/audio/transcriptions", data=form, kind=form_type)).get("text", "").strip()
            elif action == "text":
                heard = str(json.loads(body).get("text", "")).strip()[:2000]
            elif action == "speak" and TTS_URL:
                text = str(json.loads(body).get("text", ""))[:2000]
                return self.reply(HTTPStatus.OK, api(TTS_URL + "/audio/speech", {"input": text}), "audio/wav")
            else:
                return self.reply(HTTPStatus.NOT_FOUND, json.dumps({"error": "not here"}), "application/json")
            answer = ask_assistant(heard, self.phone()) if heard else ""
        except urllib.error.HTTPError as err:
            detail = err.read().decode(errors="replace")[-200:]
            return self.reply(HTTPStatus.BAD_GATEWAY, json.dumps({"error": f"{err.code}: {detail}"}), "application/json")
        except (OSError, ValueError, KeyError, IndexError) as err:
            return self.reply(HTTPStatus.BAD_GATEWAY, json.dumps({"error": str(err)}), "application/json")
        self.reply(HTTPStatus.OK, json.dumps({"heard": heard, "answer": answer}, ensure_ascii=False),
                   "application/json; charset=utf-8")

    def pointer_socket(self):
        key = self.headers.get("Sec-WebSocket-Key", "")
        accept = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        self.send_response(HTTPStatus.SWITCHING_PROTOCOLS)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        self.close_connection = True
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as remote:
                remote.connect(CEC_SOCKET)
                while (frame := read_frame(self.rfile)) is not None:
                    opcode, payload = frame
                    if opcode == 8:  # close
                        break
                    if opcode == 9:  # ping -> pong
                        self.wfile.write(bytes([0x8A, len(payload)]) + payload); self.wfile.flush()
                        continue
                    if opcode != 1:
                        continue
                    try:
                        msg = json.loads(payload)
                    except ValueError:
                        continue
                    out = {}
                    if isinstance(msg.get("m"), list) and len(msg["m"]) == 2:
                        out["pointer"] = msg["m"]
                    if msg.get("c") in ("left", "right"):
                        out["click"] = msg["c"]
                    if isinstance(msg.get("s"), int):
                        out["scroll"] = msg["s"]
                    if out:
                        remote.sendall((json.dumps(out) + "\n").encode())
        except OSError:
            pass

    def log_message(self, fmt, *args):
        pass


class HttpsServer(ThreadingHTTPServer):
    """HTTPS on the access point's address, which needn't exist yet (the Wi-Fi may come up later)."""
    daemon_threads = True

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IP, 15, 1)  # IP_FREEBIND
        super().server_bind()

    def get_request(self):
        conn, addr = self.socket.accept()
        context = tls_context()
        if not context:
            conn.close()
            raise OSError("no certificate")
        return context.wrap_socket(conn, server_side=True, do_handshake_on_connect=False), addr

    def handle_error(self, request, client_address):
        pass  # a phone that gives up mid-handshake, or doesn't trust the name, isn't news


def serve_https():
    while not tls_context():  # couchpie-ap-refresh copies the certificate at boot
        time.sleep(60)
    print(f"HTTPS for the Pi's Wi-Fi on {AP_ADDRESS}:{TLS_PORT} ({TAILNET_HOST or 'no tailnet name'})", flush=True)
    HttpsServer((AP_ADDRESS, TLS_PORT), Handler).serve_forever()


if __name__ == "__main__":
    print(f"phone remote on port {PORT}", flush=True)
    threading.Thread(target=serve_https, daemon=True).start()
    threading.Thread(target=forget_departed, daemon=True).start()
    server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    server.daemon_threads = True
    server.serve_forever()
