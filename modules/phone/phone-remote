def read_frame(stream):
    """One WebSocket frame from the client: (opcode, payload), or None when the stream ends."""
    head = stream.read(2)
    if len(head) < 2:
        return None
    opcode, length, masked = head[0] & 0x0F, head[1] & 0x7F, head[1] & 0x80
    if length == 126:
        length = int.from_bytes(stream.read(2), "big")
    elif length == 127:
        length = int.from_bytes(stream.read(8), "big")
    if length > 65536:
        return None
    mask = stream.read(4) if masked else b"\0\0\0\0"
    data = stream.read(length)
    return opcode, bytes(b ^ mask[i % 4] for i, b in enumerate(data))


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def allowed(self):
        addr = ipaddress.ip_address(self.client_address[0])
        if addr.version == 6 and addr.ipv4_mapped:
            addr = addr.ipv4_mapped
        return addr.is_private or addr.is_loopback or addr in TAILNET

    def reply(self, status, body, kind="text/plain; charset=utf-8"):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(status)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if not self.allowed():
            return self.reply(HTTPStatus.FORBIDDEN, "only from the local network")
        if self.path == "/ws" and self.headers.get("Upgrade", "").lower() == "websocket":
            return self.pointer_socket()
        if self.path in ("/", "/index.html"):
            page = PAGE.replace("__HOME_URL__", HOME_URL).replace("__TAILNET_HOST__", TAILNET_HOST)
            return self.reply(HTTPStatus.OK, page, "text/html; charset=utf-8")
        if self.path == "/apps":
            apps = [{k: a[k] for k in ("id", "name", "logo")} for a in menu_apps()]
            return self.reply(HTTPStatus.OK, json.dumps(apps, ensure_ascii=False), "application/json")
        if self.path.startswith("/logo/"):
            name = Path(self.path[len("/logo/"):]).name.replace("%20", " ")
            logo = find_logo(name) if name else None
            if logo:
                kind = {"svg": "image/svg+xml", "jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp"}.get(
                    logo.suffix.lower().lstrip("."), "image/png")
                return self.reply(HTTPStatus.OK, logo.read_bytes(), kind)
        self.reply(HTTPStatus.NOT_FOUND, "not found")

    def do_POST(self):
        if not self.allowed():
            return self.reply(HTTPStatus.FORBIDDEN, "only from the local network")
        parts = self.path.strip("/").split("/")
        try:
            if len(parts) == 2 and parts[0] == "button" and parts[1] in BUTTONS:
                cec({"button": parts[1]})
            elif len(parts) == 2 and parts[0] == "tv" and parts[1] in ("on", "standby"):
                run = subprocess.run([str(KIOSK), "wake" if parts[1] == "on" else "standby"],
                                     capture_output=True, text=True, timeout=20)
                if run.returncode:
                    return self.reply(HTTPStatus.BAD_GATEWAY, run.stderr.strip()[-200:] or "kiosk failed")
            elif len(parts) == 2 and parts[0] == "app" and parts[1] in {a["id"] for a in menu_apps()}:
                subprocess.Popen([str(KIOSK), "run", parts[1]], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
            else:
                return self.reply(HTTPStatus.NOT_FOUND, "unknown action")
        except OSError as err:
            return self.reply(HTTPStatus.SERVICE_UNAVAILABLE, f"couchPie isn't answering: {err}")
        self.reply(HTTPStatus.NO_CONTENT, b"")

    def pointer_socket(self):
        key = self.headers.get("Sec-WebSocket-Key", "")
        accept = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        self.send_response(HTTPStatus.SWITCHING_PROTOCOLS)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        self.close_connection = True
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as remote:
                remote.connect(CEC_SOCKET)
                while (frame := read_frame(self.rfile)) is not None:
                    opcode, payload = frame
                    if opcode == 8:  # close
                        break
                    if opcode == 9:  # ping -> pong
                        self.wfile.write(bytes([0x8A, len(payload)]) + payload); self.wfile.flush()
                        continue
                    if opcode != 1:
                        continue
                    try:
                        msg = json.loads(payload)
                    except ValueError:
                        continue
                    out = {}
                    if isinstance(msg.get("m"), list) and len(msg["m"]) == 2:
                        out["pointer"] = msg["m"]
                    if msg.get("c") in ("left", "right"):
                        out["click"] = msg["c"]
                    if isinstance(msg.get("s"), int):
                        out["scroll"] = msg["s"]
                    if out:
                        remote.sendall((json.dumps(out) + "\n").encode())
        except OSError:
            pass

    def log_message(self, fmt, *args):
        pass


if __name__ == "__main__":
    print(f"phone remote on port {PORT}", flush=True)
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
