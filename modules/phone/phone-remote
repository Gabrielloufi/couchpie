// Which rotation axis is horizontal and which vertical depends on how the phone is held and on
// the browser, so a two-step calibration measures it: turn right, then tilt up.
const AXES = ["alpha", "beta", "gamma"];
let cal = null;
try { cal = JSON.parse(localStorage.getItem("pointer-cal")); } catch (e) {}
cal = cal || {h: "alpha", hs: -1, v: "beta", vs: -1};
let calStep = 0, sums = {alpha: 0, beta: 0, gamma: 0}, smooth = [0, 0];
const DEAD = 2.5;  // deg/s below which the hand's tremor is ignored
function onMotion(ev) {
  const r = ev.rotationRate; if (!holding || !r) return;
  const dt = (ev.interval > 1 ? ev.interval / 1000 : ev.interval) || 0.016;
  if (calStep) { for (const a of AXES) sums[a] += (r[a] || 0) * dt; return; }
  const k = +$("gain").value;
  let h = (r[cal.h] || 0) * cal.hs, v = (r[cal.v] || 0) * cal.vs;
  h = Math.abs(h) < DEAD ? 0 : h; v = Math.abs(v) < DEAD ? 0 : v;
  smooth[0] = 0.6 * smooth[0] + 0.4 * h; smooth[1] = 0.6 * smooth[1] + 0.4 * v;  // low-pass
  acc[0] += smooth[0] * dt * k; acc[1] += smooth[1] * dt * k;
}
function calibrationDone() {  // called when the pad is released during calibration
  const best = (exclude) => AXES.filter(a => a !== exclude)
    .reduce((x, y) => Math.abs(sums[x]) >= Math.abs(sums[y]) ? x : y);
  if (calStep === 1) {
    const ax = best(null); cal.h = ax; cal.hs = sums[ax] >= 0 ? 1 : -1;   // right = +x
    calStep = 2; sums = {alpha: 0, beta: 0, gamma: 0};
    pad.innerHTML = "Passo 2: segure aqui e incline o celular para CIMA, depois solte";
  } else {
    const ax = best(cal.h); cal.v = ax; cal.vs = sums[ax] >= 0 ? -1 : 1;  // up = -y
    calStep = 0;
    try { localStorage.setItem("pointer-cal", JSON.stringify(cal)); } catch (e) {}
    pad.innerHTML = "Segure aqui e aponte o celular para a TV<br><small>toque rápido = clique</small>";
    say("Calibrado: horizontal = " + cal.h + ", vertical = " + cal.v);
  }
}
function flush() {
  const dx = Math.trunc(acc[0]), dy = Math.trunc(acc[1]);
  if (dx || dy) { send({m: [dx, dy]}); acc[0] -= dx; acc[1] -= dy; moved += Math.abs(dx) + Math.abs(dy); }
  requestAnimationFrame(flush);
}
$("pointer-start").addEventListener("click", async () => {
