<script>
const status = document.getElementById("status");
const say = (text) => { status.textContent = text; clearTimeout(say.t); say.t = setTimeout(() => status.textContent = "", 2500); };
async function post(path) {
  if (navigator.vibrate) navigator.vibrate(15);
  try {
    const r = await fetch(path, {method: "POST"});
    if (!r.ok) say("Não deu: " + (await r.text()));
  } catch (e) { say("Sem conexão com o couchPie"); }
}
document.querySelectorAll("[data-post]").forEach(b => b.addEventListener("click", () => post(b.dataset.post)));
document.querySelectorAll("[data-button]").forEach(b => {
  const go = () => post("/button/" + b.dataset.button);
  if (!("repeat" in b.dataset)) { b.addEventListener("click", go); return; }
  let timer;  // arrows repeat while held
  const stop = () => { clearInterval(timer); timer = null; };
  b.addEventListener("pointerdown", e => { e.preventDefault(); go(); stop(); timer = setTimeout(() => { timer = setInterval(go, 150); }, 450); });
  ["pointerup", "pointerleave", "pointercancel"].forEach(ev => b.addEventListener(ev, stop));
});
fetch("/apps").then(r => r.json()).then(apps => {
  const box = document.getElementById("apps");
  for (const app of apps) {
    const b = document.createElement("button");
    if (app.logo) { const img = document.createElement("img"); img.src = "/logo/" + encodeURIComponent(app.logo); img.alt = ""; b.append(img); }
    b.append(app.name);
    b.addEventListener("click", () => { post("/app/" + app.id); say("Abrindo " + app.name + "…"); });
    box.append(b);
  }
});
