#!/bin/sh
# NetworkManager dispatcher for couchPie's access point (couchpie-ap on wlan0).
# - Its clients reach the internet through eth0. NetworkManager NATs them in its own nft table,
#   but Docker sets the iptables FORWARD policy to DROP, which drops them anyway. Docker leaves
#   the DOCKER-USER chain to us: accept there.
# - Port 80 on the Pi's address goes to the phone remote (8096), which answers the phones'
#   internet checks and shows the sign-in page (couchpie-ap-refresh points those checks here).
[ "$1" = wlan0 ] && [ "$2" = up ] || exit 0
AP_ADDRESS=10.42.0.1
[ -f /etc/default/couchpie-ap ] && . /etc/default/couchpie-ap
iptables -N DOCKER-USER 2>/dev/null
iptables -C DOCKER-USER -i wlan0 -o eth0 -j ACCEPT 2>/dev/null ||
    iptables -I DOCKER-USER -i wlan0 -o eth0 -j ACCEPT
iptables -C DOCKER-USER -i eth0 -o wlan0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null ||
    iptables -I DOCKER-USER -i eth0 -o wlan0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
iptables -t nat -C PREROUTING -i wlan0 -d "$AP_ADDRESS" -p tcp --dport 80 -j REDIRECT --to-ports 8096 2>/dev/null ||
    iptables -t nat -I PREROUTING -i wlan0 -d "$AP_ADDRESS" -p tcp --dport 80 -j REDIRECT --to-ports 8096
systemctl start --no-block couchpie-ap-refresh.service
